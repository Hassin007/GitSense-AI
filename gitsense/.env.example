# ── App ──────────────────────────────────────────────────────
APP_SECRET_KEY=your-secret-key-min-32-chars-long
FRONTEND_URL=http://localhost:8501

# ── Database & Redis ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/gitsense
REDIS_URL=redis://localhost:6379/0

# ── GitHub OAuth App ─────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New
# Homepage URL:      http://localhost:8501
# Callback URL:      http://localhost:8000/auth/callback
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# ── GitHub Webhook ────────────────────────────────────────────
# Set this to your ngrok URL when testing locally
# e.g. https://abc123.ngrok-free.app
WEBHOOK_BASE_URL=https://your-ngrok-url-here
GITHUB_WEBHOOK_SECRET=your-webhook-signing-secret-min-32-chars

# ── LLM Provider Keys ────────────────────────────────────────
# Get a free key at: console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxx

# Get a free key at: aistudio.google.com/apikey
GOOGLE_API_KEY=xxxxxxxxxxxx

# Get a free key at: build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxx

# ── Langfuse Observability ──────────────────────────────────
# Get keys at: cloud.langfuse.com (or self-hosted instance)
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

