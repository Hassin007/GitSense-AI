# ==============================================================================
# GitSense AI — Package .gitignore (gitsense/)
# ==============================================================================

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.*
.env.local
.env.*.local
!.env.example
*.pem
*.key

# ── Python Cache & Bytecode ───────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── Python Build & Packaging ──────────────────────────────────────────────────
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.whl

# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Testing, Test Suites, Benchmarks & Coverage ──────────────────────────────
.pytest_cache/
**/pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
.tox/
.nox/
.backend/tests/
backend/tests/
tests/
test/
**/tests/
**/test/
demo_test_suite/
test-suite/
testfiles/
scripts/
**/scripts/
test_*.py
*_test.py
test.py
benchmark_*.py
stress_*.py

# ── Prompts & LLM Experimentation ─────────────────────────────────────────────
prompts/
**/prompts/
*Prompt*.md
*prompt*.md

# ── Internal Development Notes, Analysis & Scratchpads ────────────────────────
CLAUDE.md
**/CLAUDE.md
GEMINI_429_TPM_ANALYSIS.md
**/GEMINI_429_TPM_ANALYSIS.md
PRODUCTION_ISSUES.md
**/PRODUCTION_ISSUES.md
KNOWN_ISSUES.md
**/KNOWN_ISSUES.md
TODO.md
**/TODO.md

# ── AI Agent Tooling & Workspace Caches ───────────────────────────────────────
.agent/
.agents/
**/.agent/
**/.agents/

# ── Type Checking / Linting ───────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/

# ── IDE & Editor Settings ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS Generated Files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Database & Storage ────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.dump

# ── Logs & Debug Output ───────────────────────────────────────────────────────
*.log
logs/
**/logs/
backend.log
**/backend.log

# ── PDF Exports & Temp Files ──────────────────────────────────────────────────
*.pdf
exports/
temp/
tmp/
*.bak
*.tmp
